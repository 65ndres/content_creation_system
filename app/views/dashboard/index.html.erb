<% content_for :title, "Stories" %>

<header class="page-head">
  <div>
    <p class="kicker">Library</p>
    <h1>Stories</h1>
  </div>
  <%= link_to "New story", new_story_path, class: "btn btn-primary" %>
</header>

<% if @running.any? || @waiting.any? || @failed.any? %>
  <section class="queue-panel" aria-label="Story queue">
    <% [ [ "Running", @running ], [ "Up next", @waiting ], [ "Failed", @failed ] ].each do |label, stories| %>
      <% next if stories.empty? %>
      <div class="queue-group">
        <p class="field-label"><%= label %></p>
        <ol class="queue-list">
          <% stories.each do |story| %>
            <li class="queue-item">
              <%= link_to story_path(story), class: "queue-name" do %>
                <span class="story-id">#<%= story.id %></span>
                <span><%= story.story_type&.name.presence || "Untitled" %></span>
              <% end %>
              <% if story.queue_failed? && story.last_error.present? %>
                <span class="muted queue-error"><%= story.last_error %></span>
              <% elsif story.queue_running? && story.started_at %>
                <span class="muted">started <%= time_ago_in_words(story.started_at) %> ago</span>
              <% end %>
              <% if story.queue_failed? %>
                <%= button_to "Retry", retry_story_path(story), method: :post, class: "btn btn-small" %>
              <% else %>
                <%= button_to "Cancel", cancel_story_path(story), method: :post, class: "btn btn-small" %>
              <% end %>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>
  </section>
<% end %>

<% if @stories.empty? %>
  <section class="empty">
    <p>No stories yet.</p>
    <p class="muted">Create a source and a story type, then open New story.</p>
  </section>
<% else %>
  <ul class="story-list">
    <% @stories.each do |story| %>
      <li>
        <%= link_to story_path(story), class: "story-row" do %>
          <span class="story-id">#<%= story.id %></span>
          <span class="story-body">
            <strong><%= story.story_type&.name.presence || "Untitled" %></strong>
            <span class="muted"><%= truncate(story.text.to_s.presence || story.source&.text.to_s, length: 120) %></span>
          </span>
          <span class="meta">
            <span class="pill"><%= story_status(story) %></span>
            <span class="muted"><%= story.scenes.size %> scenes</span>
            <time datetime="<%= story.created_at.iso8601 %>"><%= story.created_at.strftime("%b %-d, %Y") %></time>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
