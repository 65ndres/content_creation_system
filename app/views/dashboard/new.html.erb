<% content_for :title, "New story" %>

<header class="page-head">
  <div>
    <p class="kicker">Create</p>
    <h1>New story</h1>
  </div>
</header>

<% if @story_types.empty? || @sources.empty? %>
  <section class="empty">
    <p>A story needs one source and one story type.</p>
    <p class="muted">
      <%= link_to "Create a source", new_source_path %>
      and
      <%= link_to "create a story type", new_story_type_path %>
      first.
    </p>
  </section>
<% else %>
  <%= form_with model: @story, url: create_story_path, method: :post, local: true, class: "composer" do |form| %>
    <% if @story.errors.any? %>
      <p class="is-error"><%= @story.errors.full_messages.to_sentence %></p>
    <% end %>

    <div class="form-grid">
      <label>
        <span class="field-label">Story type</span>
        <%= form.select :story_type_id, options_from_collection_for_select(@story_types, :id, :name, @story.story_type_id), { prompt: "Choose one" }, class: "select", required: true %>
      </label>

      <label>
        <span class="field-label">Image model</span>
        <%= form.select :image_generation_model, @image_models.map { |value, label| [ label, value ] }, {}, class: "select" %>
      </label>

      <label>
        <span class="field-label">Video model</span>
        <%= form.select :video_generation_model, ([ [ "None (stills + motion)", "" ] ] + @video_models.map { |value, label| [ label, value ] }), {}, class: "select" %>
      </label>
    </div>

    <fieldset class="source-field">
      <legend class="field-label">Sources <span class="muted">· pick one or more, each becomes its own story</span></legend>
      <% picked = Array(params.dig(:story, :source_ids)).map(&:to_s).presence || [ @story.source_id.to_s ] %>
      <div class="source-picker">
        <% @sources.each do |source| %>
          <label class="source-option">
            <%= check_box_tag "story[source_ids][]", source.id, picked.include?(source.id.to_s), id: "story_source_ids_#{source.id}" %>
            <span><%= source.dashboard_label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <label class="checkbox-field">
      <%= form.check_box :auto_produce %>
      <span>
        <strong>Produce the full video automatically</strong>
        <span class="muted">Generates every scene, then the final video. No clicks needed.</span>
      </span>
    </label>

    <div class="composer-bar">
      <p class="muted">Stories run one at a time. Extra ones wait in the queue.</p>
      <%= form.submit "Create stories", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
